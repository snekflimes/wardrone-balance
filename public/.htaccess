DirectoryIndex index.html

# SPA в подпапке /wardrone/: прямые ссылки /wardrone/economy и т.д. → index.html.
# Реальные файлы (assets, *.js, api/*.php) отдаются как есть.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /wardrone/

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>
